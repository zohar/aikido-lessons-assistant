# Carnet de séances : nginx (Coolify).
# ${N8N_WEBHOOK_URL} is filled from the environment at container start.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header X-Frame-Options DENY always;
    add_header X-Robots-Tag "noindex, nofollow" always;

    location = /healthz { access_log off; return 200 "ok\n"; }

    # The only API route: forwarded to the n8n production webhook.
    # The browser sends the access code in X-Carnet-Code; n8n checks it.
    location = /api/carnet-seances {
        limit_except POST { deny all; }
        proxy_pass ${N8N_WEBHOOK_URL};
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        client_max_body_size 256k;
    }
    location /api/ { return 404; }

    # "expires" sets Cache-Control without dropping the server-level add_header lines.
    location = /index.html { expires -1; }
    location ~* \.(css|js)$ { expires 5m; }
    location / { try_files $uri $uri/ /index.html; }
}
